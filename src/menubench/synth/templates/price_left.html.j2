{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block style %}
  .row { display: grid; grid-template-columns: calc(var(--size) * {{ theme.price_col }}) 1fr; gap: 14px; margin-top: calc(var(--size) * 0.55); align-items: baseline; }
  .prices { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  .prices .price { color: var(--accent); }
  .pair { white-space: nowrap; }
{% endblock %}
{% block body %}
{% for s in menu.sections %}
<section>
  <h2><span data-mb-kind="section">{{ s.title }}</span></h2>
  {% for it in s.items %}
  <div class="row">
    <div class="prices">
      {% for p in it.prices %}<span class="pair">{% if p.size_label %}<span class="size" data-mb-kind="size">{{ p.size_label }}</span> {% endif %}{{ m.price(it, p, loop.first) }}</span>{% endfor %}
    </div>
    <div>
      {{ m.item(it) }}{% if it.weight %} <span class="size">· <span data-mb-kind="other">{{ it.weight }}</span></span>{% endif %}
      {% if it.description %}<div class="desc"><span data-mb-kind="description">{{ it.description }}</span></div>{% endif %}
    </div>
  </div>
  {% endfor %}
</section>
{% endfor %}
{% endblock %}
