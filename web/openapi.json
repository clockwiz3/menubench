 "components": {
  "schemas": {
   "AugmentLevel": {
    "type": "string",
    "enum": [
     "clean",
     "scan",
     "photo"
    ],
    "title": "AugmentLevel"
   },
   "BBox": {
    "properties": {
     "x0": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "X0"
     },
     "y0": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Y0"
     },
     "x1": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "X1"
     },
     "y1": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Y1"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "x0",
     "y0",
     "x1",
     "y1"
    ],
    "title": "BBox"
   },
   "Body_start_api_try_jobs_post": {
    "properties": {
     "file": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "File"
     }
    },
    "type": "object",
    "required": [
     "file"
    ],
    "title": "Body_start_api_try_jobs_post"
   },
   "Body_upload_api_annotate_menus_post": {
    "properties": {
     "files": {
      "items": {
       "type": "string",
       "contentMediaType": "application/octet-stream"
      },
      "type": "array",
      "title": "Files"
     }
    },
    "type": "object",
    "required": [
     "files"
    ],
    "title": "Body_upload_api_annotate_menus_post"
   },
   "CatalogEntry": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "id",
     "name"
    ],
    "title": "CatalogEntry"
   },
   "GalleryItem": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "title": {
      "type": "string",
      "title": "Title"
     },
     "note": {
      "type": "string",
      "title": "Note"
     },
     "job": {
      "$ref": "#/components/schemas/TryJob"
     }
    },
    "type": "object",
    "required": [
     "id",
     "title",
     "note",
     "job"
    ],
    "title": "GalleryItem"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LinkCandidate": {
    "properties": {
     "catalog_id": {
      "type": "string",
      "title": "Catalog Id"
     },
     "score": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "catalog_id",
     "score"
    ],
    "title": "LinkCandidate"
   },
   "LinkDecision": {
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "link",
       "hint",
       "abstain"
      ],
      "title": "Action"
     },
     "catalog_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Catalog Id"
     },
     "candidates": {
      "items": {
       "$ref": "#/components/schemas/LinkCandidate"
      },
      "type": "array",
      "title": "Candidates",
      "default": []
     },
     "reason": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Reason"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "action"
    ],
    "title": "LinkDecision",
    "description": "Track B outcome for one predicted price."
   },
   "MenuAnnotation": {
    "properties": {
     "menu_id": {
      "type": "string",
      "title": "Menu Id"
     },
     "source": {
      "$ref": "#/components/schemas/Source"
     },
     "lang": {
      "type": "string",
      "title": "Lang"
     },
     "pages": {
      "items": {
       "$ref": "#/components/schemas/Page"
      },
      "type": "array",
      "minItems": 1,
      "title": "Pages"
     },
     "items": {
      "items": {
       "$ref": "#/components/schemas/MenuItem"
      },
      "type": "array",
      "title": "Items",
      "default": []
     },
     "prices": {
      "items": {
       "$ref": "#/components/schemas/PriceAnnotation-Output"
      },
      "type": "array",
      "title": "Prices",
      "default": []
     },
     "catalog": {
      "items": {
       "$ref": "#/components/schemas/CatalogEntry"
      },
      "type": "array",
      "title": "Catalog",
      "default": []
     },
     "lines": {
      "items": {
       "$ref": "#/components/schemas/TextLine"
      },
      "type": "array",
      "title": "Lines",
      "default": []
     },
     "template": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Template"
     },
     "augment": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/AugmentLevel"
       },
       {
        "type": "null"
       }
      ]
     },
     "seed": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Seed"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Tags",
      "default": []
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "menu_id",
     "source",
     "lang",
     "pages"
    ],
    "title": "MenuAnnotation",
    "description": "Ground truth for one menu."
   },
   "MenuDraft": {
    "properties": {
     "lang": {
      "type": "string",
      "title": "Lang"
     },
     "items": {
      "items": {
       "$ref": "#/components/schemas/MenuItem"
      },
      "type": "array",
      "title": "Items"
     },
     "prices": {
      "items": {
       "$ref": "#/components/schemas/PriceAnnotation-Input"
      },
      "type": "array",
      "title": "Prices"
     },
     "catalog": {
      "items": {
       "$ref": "#/components/schemas/CatalogEntry"
      },
      "type": "array",
      "title": "Catalog",
      "default": []
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Tags",
      "default": []
     },
     "status": {
      "$ref": "#/components/schemas/Status"
     },
     "split": {
      "type": "string",
      "title": "Split",
      "default": "real-test"
     },
     "notes": {
      "type": "string",
      "title": "Notes",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "lang",
     "items",
     "prices",
     "status"
